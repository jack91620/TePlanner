// Local build configuration — copy to Config.xcconfig (gitignored) and fill in.
// See docs/ios-port-plan.md for context on AMap iOS SDK setup.

// Bundle identifier — must match what's registered on the AMap console.
PRODUCT_BUNDLE_IDENTIFIER = com.teplanner.ios

// AMap iOS API key — apply at https://console.amap.com/dev/key/app
// Keep this OUT of git. Only put it in Config.xcconfig (which is gitignored).
AMAP_API_KEY = your_amap_ios_key_here

// Backend base URL. Defaults to local dev server; override per-machine.
// xcconfig treats // as a line comment — break it with $() so the URL
// scheme survives substitution into Info.plist's BackendURL key.
BACKEND_URL = http:/$()/127.0.0.1:8000/api/v1

// Apple Developer Team ID — required for device builds + TestFlight.
// Find yours: Xcode → Settings → Accounts → select team → "Team ID".
// Free Apple IDs work for `make run-device` but cannot upload to
// TestFlight (need a paid Apple Developer Program membership).
DEVELOPMENT_TEAM =

// Build number — bumped before each TestFlight upload.
// `make next-build` increments this; CFBundleShortVersionString
// (the user-facing version like 1.0.0) lives in project.yml.
CURRENT_PROJECT_VERSION = 1
