# TePlanner backend — environment template.
# Copy to backend/.env and fill in real values. Never commit the
# real .env (gitignored).
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------- App ----------
APP_NAME=TePlanner
APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_RANDOM_32B
HOST=127.0.0.1
PORT=8000
WORKERS=2

# ---------- Database ----------
DATABASE_URL=sqlite+aiosqlite:///./teplanner.db

# Set to "true" only on a fresh box where you want app startup to
# create tables via SQLAlchemy create_all. Production runs alembic
# migrations as a deploy-time step instead.
DB_AUTO_MIGRATE=false

# ---------- Tesla Fleet API ----------
TESLA_API_BASE_URL=https://owner-api.teslamotors.com
TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.cn.vn.cloud.tesla.cn
TESLA_CLIENT_ID=REPLACE_WITH_TESLA_CLIENT_ID
TESLA_CLIENT_SECRET=REPLACE_WITH_TESLA_CLIENT_SECRET
TESLA_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
TESLA_REDIRECT_URI=https://api.teplanner.cloud/api/v1/auth/tesla/callback

# Tesla VCP — proxy URL (signed commands route here, state reads stay
# direct). Run via tesla-http-proxy.service; see ops/systemd/.
TESLA_VEHICLE_COMMAND_PROXY_URL=https://127.0.0.1:4443

# Optional standalone fixtures for offline integration tests
TESLA_ACCESS_TOKEN=
TESLA_REFRESH_TOKEN=

# ---------- AMap (高德 Web Service) ----------
# Backend uses Web Service for routing + nearby + geocoding. iOS / Android
# use their own native AMap SDK keys (in apps/<platform>/...).
AMAP_WEB_API_KEY=REPLACE_WITH_AMAP_WEB_KEY
TENCENT_MAP_KEY=
TENCENT_MAP_API_KEY=
TENCENT_MAP_SECRET=

# ---------- WeChat Mini Program (legacy) ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- JWT ----------
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32B
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- CORS ----------
CORS_ORIGINS=*

# ---------- APNs (iOS push) ----------
APNS_AUTH_KEY_PATH=/home/ubuntu/teplanner-keys/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=REPLACE_WITH_KEY_ID
APNS_TEAM_ID=REPLACE_WITH_TEAM_ID
APNS_BUNDLE_ID=com.teplanner.ios
APNS_ENVIRONMENT=production

# ---------- Tesla Fleet Telemetry consumer ----------
TELEMETRY_ZMQ_ADDR=tcp://127.0.0.1:5557

# ---------- OpenClaw alert webhook ----------
# ERROR+ logs forwarded to OpenClaw → WeChat to Jack. install() runs
# from app/main.py if both URL + TOKEN are set. Token shared with
# ~/.openclaw/openclaw.json (hooks.token) and /home/ubuntu/ops/alert.env.
OPENCLAW_HOOK_URL=http://127.0.0.1:18789/hooks
OPENCLAW_HOOK_TOKEN=REPLACE_WITH_HOOK_TOKEN

# ---------- JPush (Android push, mainland China) ----------
JPUSH_APP_KEY=REPLACE_WITH_JPUSH_APP_KEY
JPUSH_MASTER_SECRET=REPLACE_WITH_JPUSH_MASTER_SECRET
JPUSH_PRODUCTION=true

# ---------- Automation engine ----------
# Cron tick interval (seconds). 0 disables.
AUTOMATION_CRON_TICK_SECONDS=30
AUTOMATION_POLL_INTERVAL_SECONDS=300
