.search-bar {
  display: flex;
  align-items: center;
  background: #2a2a2a;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-icon image {
  width: 100%;
  height: 100%;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #ffffff;
  background: transparent;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.5);
  font-size: 30rpx;
}
