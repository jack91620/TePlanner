.station-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.station-item:active {
  background: rgba(255, 255, 255, 0.05);
  margin: 0 -32rpx;
  padding: 28rpx 32rpx;
}

.station-info {
  flex: 1;
  min-width: 0;
}

.station-name {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 400;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.station-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.meta-dot {
  margin: 0 8rpx;
  color: rgba(255, 255, 255, 0.3);
}

.station-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 24rpx;
}

.badge-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: #e82127;
  border-radius: 16rpx 16rpx 16rpx 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon.available {
  background: #e82127;
}

.badge-icon.busy {
  background: #8b8b8b;
}

.lightning-icon {
  width: 28rpx;
  height: 36rpx;
}

.badge-number {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #e82127;
  border: 3rpx solid #171717;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.clock-icon {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #171717;
  border-radius: 50%;
}

.badge-distance {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}
