<view class="station-item" bindtap="onTap">
  <view class="station-info">
    <text class="station-name">{{station.name}}</text>
    <view class="station-meta">
      <text class="meta-text">最大功率{{station.power_kw || 250}} kW</text>
      <text class="meta-dot">·</text>
      <text class="meta-text" wx:if="{{station.available !== undefined}}">
        {{station.available}}/{{station.total}}可用
      </text>
      <text class="meta-text" wx:elif="{{station.stalls}}">
        容量：{{station.stalls}}个充电桩
      </text>
    </view>
  </view>

  <view class="station-badge">
    <view class="badge-icon {{station.available > 0 ? 'available' : (station.available === 0 ? 'busy' : '')}}">
      <image src="/assets/icons/lightning.png" class="lightning-icon" />
      <text class="badge-number" wx:if="{{station.available !== undefined}}">{{station.available}}</text>
      <image src="/assets/icons/clock.png" class="clock-icon" wx:if="{{station.waitTime}}" />
    </view>
    <text class="badge-distance">{{station.distance || station.distance_km}} km</text>
  </view>
</view>
