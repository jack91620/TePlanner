/**
 * TePlanner Global Styles
 * Tesla-inspired Dark Theme
 */

/* CSS Variables */
page {
  /* Tesla Dark Theme (Primary) */
  --tesla-bg: #171717;
  --tesla-bg-secondary: #242424;
  --tesla-bg-tertiary: #2a2a2a;
  --tesla-bg-elevated: #333333;
  --tesla-text-primary: #ffffff;
  --tesla-text-secondary: rgba(255, 255, 255, 0.7);
  --tesla-text-tertiary: rgba(255, 255, 255, 0.5);
  --tesla-text-quaternary: rgba(255, 255, 255, 0.3);
  --tesla-accent: #e82127;
  --tesla-accent-blue: #3e6ae1;
  --tesla-border: rgba(255, 255, 255, 0.1);
  --tesla-success: #34c759;
  --tesla-warning: #ff9500;
  --tesla-error: #ff3b30;

  /* Legacy Variables (for compatibility) */
  --primary-color: #e82127;
  --secondary-color: #171717;
  --background-color: #171717;
  --card-background: #242424;
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.7);
  --text-muted: rgba(255, 255, 255, 0.5);
  --border-color: rgba(255, 255, 255, 0.1);
  --success-color: #34c759;
  --warning-color: #ff9500;
  --error-color: #ff3b30;

  background-color: var(--tesla-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  color: var(--tesla-text-primary);
  line-height: 1.5;
}

/* Common Components */
.container {
  padding: 30rpx;
}

.card {
  background: var(--card-background);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* Buttons */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: var(--tesla-accent-blue);
  color: #ffffff;
}

.btn-secondary {
  background: var(--tesla-bg-tertiary);
  color: #ffffff;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--tesla-border);
  color: var(--tesla-text-primary);
}

.btn-disabled {
  background: var(--tesla-bg-tertiary);
  color: var(--tesla-text-tertiary);
  pointer-events: none;
}

/* Tesla Blue Button */
.btn-tesla {
  background: var(--tesla-accent-blue);
  color: #ffffff;
  border-radius: 16rpx;
}

/* Input Fields */
.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.input-field {
  height: 88rpx;
  background: var(--tesla-bg-tertiary);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--tesla-text-primary);
}

/* Loading States */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--tesla-accent-blue);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Empty States */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
  text-align: center;
}

.empty-state-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 30rpx;
  color: var(--text-muted);
}

/* Flex Utilities */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* Spacing */
.mt-20 { margin-top: 20rpx; }
.mt-40 { margin-top: 40rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-40 { margin-bottom: 40rpx; }
.p-20 { padding: 20rpx; }
.p-40 { padding: 40rpx; }

/* Safe Area */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
