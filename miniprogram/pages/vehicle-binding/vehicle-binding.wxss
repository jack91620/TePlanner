/* pages/vehicle-binding/vehicle-binding.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 200rpx;
}

.intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60rpx 40rpx;
  background: #ffffff;
}

.tesla-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.tesla-logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #e82127 0%, #cc1b20 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333333;
}

.intro-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* Card */
.card {
  margin: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #333333;
}

/* Benefits */
.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
}

.benefit-icon {
  width: 48rpx;
  height: 48rpx;
  background: #3e6ae1;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.benefit-content {
  flex: 1;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 6rpx;
  color: #333333;
}

.benefit-desc {
  font-size: 26rpx;
  color: #999999;
}

/* Privacy */
.privacy-card {
  background: #f8f9fa;
}

.privacy-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
}

.privacy-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* Bottom Actions */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skip-link {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999999;
}

/* Buttons */
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn-primary {
  background: #3e6ae1;
  color: #ffffff;
}

.btn-primary:active {
  background: #2d4fa8;
}

.btn-secondary {
  background: #f5f5f5;
  color: #333333;
}

.btn-secondary:active {
  background: #ebebeb;
}

/* ============ Waiting State ============ */
.waiting-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  background: #ffffff;
}

.waiting-icon {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid #3e6ae1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  animation: pulse 2s ease-in-out infinite;
}

.waiting-icon-inner {
  width: 60rpx;
  height: 60rpx;
  background: #3e6ae1;
  border-radius: 50%;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

.waiting-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.waiting-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 48rpx;
}

.steps-guide {
  width: 100%;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.step-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.step-item:not(:last-child) {
  border-bottom: 1rpx solid #eeeeee;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  background: #3e6ae1;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 28rpx;
  color: #333333;
}

.waiting-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cancel-link {
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  padding: 20rpx;
}

/* ============ Result State ============ */
.result-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: #ffffff;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  background: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.success-check {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  background: #ee0a24;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.error-mark {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
}

.result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 48rpx;
}

.error-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
