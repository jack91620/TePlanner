/* pages/vehicle-binding/vehicle-binding.wxss */

.intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60rpx 40rpx;
}

.tesla-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.tesla-logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #e82127 0%, #cc1b20 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.intro-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* Benefits */
.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
}

.benefit-icon {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.benefit-content {
  flex: 1;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 6rpx;
}

.benefit-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* Privacy */
.privacy-card {
  background: #f8f9fa;
}

.privacy-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.privacy-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* Bottom Actions */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skip-link {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.container {
  padding-bottom: 200rpx;
}
