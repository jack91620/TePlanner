<!--pages/vehicle-binding/vehicle-binding.wxml-->
<view class="container">
  <!-- Intro -->
  <view class="intro">
    <view class="tesla-logo-placeholder">T</view>
    <text class="intro-title">连接 Tesla 账户</text>
    <text class="intro-desc">连接你的 Tesla 账户，获取实时电池状态并优化路线规划</text>
  </view>

  <!-- Benefits -->
  <view class="card">
    <view class="section-title">连接后可获取</view>
    <view class="benefit-list">
      <view class="benefit-item">
        <view class="benefit-icon">1</view>
        <view class="benefit-content">
          <text class="benefit-title">实时电池状态</text>
          <text class="benefit-desc">从车辆获取精确的电量数据</text>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">2</view>
        <view class="benefit-content">
          <text class="benefit-title">精准续航估算</text>
          <text class="benefit-desc">基于你的实际车辆配置</text>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">3</view>
        <view class="benefit-content">
          <text class="benefit-title">最优充电规划</text>
          <text class="benefit-desc">根据电量定制充电方案</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Privacy Notice -->
  <view class="card privacy-card">
    <text class="privacy-title">隐私与安全</text>
    <text class="privacy-text">我们仅访问车辆的电池状态和位置信息，不会存储你的 Tesla 密码，也不会远程控制你的车辆。</text>
  </view>

  <!-- Bind Button -->
  <view class="bottom-actions">
    <button class="btn btn-primary" bindtap="startBinding" loading="{{loading}}">
      连接 Tesla 账户
    </button>
    <text class="skip-link" bindtap="skipBinding">暂时跳过</text>
  </view>
</view>
