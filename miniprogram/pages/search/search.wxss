.container {
  min-height: 100vh;
  background: #171717;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Search Header */
.search-header {
  padding: 20rpx 32rpx;
  background: #171717;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  background: #2a2a2a;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #ffffff;
  background: transparent;
}

.placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  margin-left: 16rpx;
}

.clear-btn text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* Results List */
.results-list {
  height: calc(100vh - 120rpx);
}

.result-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.result-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.result-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.result-icon image {
  width: 100%;
  height: 100%;
  opacity: 0.6;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-name {
  font-size: 32rpx;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-address {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* Loading State */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* Recent Searches */
.recent-section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.section-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.clear-link {
  font-size: 26rpx;
  color: #3e6ae1;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.recent-item:active {
  opacity: 0.7;
}

.recent-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  opacity: 0.5;
}

.recent-text {
  font-size: 30rpx;
  color: #ffffff;
}
