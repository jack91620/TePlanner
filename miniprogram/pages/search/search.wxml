<view class="container">
  <!-- Search Input -->
  <view class="search-header">
    <view class="search-box">
      <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
      <input
        class="search-input"
        type="text"
        placeholder="输入目的地"
        placeholder-class="placeholder"
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onSearch"
        focus="{{true}}"
        confirm-type="search"
      />
      <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearInput">
        <text>X</text>
      </view>
    </view>
  </view>

  <!-- Search Results -->
  <scroll-view class="results-list" scroll-y="{{true}}" wx:if="{{results.length > 0}}">
    <view
      class="result-item"
      wx:for="{{results}}"
      wx:key="id"
      bindtap="onResultTap"
      data-item="{{item}}"
    >
      <view class="result-icon">
        <image src="/assets/icons/location-pin.png" mode="aspectFit" />
      </view>
      <view class="result-info">
        <text class="result-name">{{item.title || item.name}}</text>
        <text class="result-address">{{item.address}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- Empty State -->
  <view class="empty-state" wx:if="{{!loading && results.length === 0 && searched}}">
    <text class="empty-text">未找到相关地点</text>
  </view>

  <!-- Loading -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">搜索中...</text>
  </view>

  <!-- Recent Searches -->
  <view class="recent-section" wx:if="{{!searched && recentSearches.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近搜索</text>
      <text class="clear-link" bindtap="clearRecent">清除</text>
    </view>
    <view
      class="recent-item"
      wx:for="{{recentSearches}}"
      wx:key="index"
      bindtap="onRecentTap"
      data-keyword="{{item}}"
    >
      <image class="recent-icon" src="/assets/icons/history.png" mode="aspectFit" />
      <text class="recent-text">{{item}}</text>
    </view>
  </view>
</view>
