/* pages/station-detail/station-detail.wxss */

.station-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.station-name {
  font-size: 36rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 20rpx;
}

.station-type {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  color: #ffffff;
}

.station-type.supercharger {
  background: #e63946;
}

.station-type.destination {
  background: #3498db;
}

.station-type.third_party {
  background: #9b59b6;
}

.station-address {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* Charge Plan */
.charge-plan {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.plan-item {
  display: flex;
  flex-direction: column;
}

.plan-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.plan-value {
  font-size: 32rpx;
  font-weight: 600;
}

/* Bottom Actions */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.container {
  padding-bottom: 150rpx;
}
