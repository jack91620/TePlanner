<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- User Info -->
  <view class="card user-card">
    <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname || 'Tesla Owner'}}</text>
      <text class="user-status" wx:if="{{hasVehicle}}">Vehicle Connected</text>
      <text class="user-status not-connected" wx:else>No Vehicle Connected</text>
    </view>
  </view>

  <!-- Vehicle Info -->
  <view class="card" wx:if="{{hasVehicle && vehicle}}">
    <view class="section-title">My Vehicle</view>
    <view class="vehicle-info-card">
      <view class="vehicle-main">
        <text class="vehicle-name">{{vehicle.displayName || 'My Tesla'}}</text>
        <text class="vehicle-type">{{vehicle.carType}}</text>
      </view>
      <view class="vehicle-stats">
        <view class="stat-item">
          <text class="stat-value">{{vehicle.batteryLevel || '--'}}%</text>
          <text class="stat-label">Battery</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{vehicle.rangeKm || '--'}}</text>
          <text class="stat-label">Range (km)</text>
        </view>
      </view>
    </view>
    <button class="btn btn-outline refresh-btn" bindtap="refreshVehicle" loading="{{refreshing}}">
      Refresh Status
    </button>
  </view>

  <!-- Bind Vehicle Prompt -->
  <view class="card bind-card" wx:if="{{!hasVehicle}}" bindtap="goToBindVehicle">
    <text class="bind-title">Connect Tesla Account</text>
    <text class="bind-desc">Link your account for real-time data</text>
    <text class="bind-arrow">></text>
  </view>

  <!-- Menu Items -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-text">Settings</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="viewTripHistory">
      <text class="menu-text">Trip History</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" wx:if="{{hasVehicle}}" bindtap="unbindVehicle">
      <text class="menu-text danger">Disconnect Tesla</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- Version -->
  <view class="version-info">
    <text>TePlanner v1.0.0</text>
  </view>
</view>
