/* pages/index/index.wxss */

.vehicle-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d44 100%);
  color: #ffffff;
}

.vehicle-header {
  flex-wrap: wrap;
}

.vehicle-info {
  display: flex;
  flex-direction: column;
}

.vehicle-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.vehicle-status {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.status-online {
  color: #2ecc71;
}

.battery-info {
  text-align: right;
}

.battery-level {
  font-size: 48rpx;
  font-weight: 700;
}

.battery-bar {
  width: 120rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  margin: 8rpx 0;
  overflow: hidden;
}

.battery-fill {
  height: 100%;
  background: #2ecc71;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.battery-range {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Bind Prompt */
.bind-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx;
}

.tesla-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.bind-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.bind-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* Location Input */
.location-input {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.location-input:last-of-type {
  border-bottom: none;
}

.location-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.origin-icon {
  background: #2ecc71;
}

.dest-icon {
  background: #e63946;
}

.location-text {
  flex: 1;
  font-size: 30rpx;
}

.placeholder {
  color: var(--text-muted);
}

.location-action {
  margin-left: 16rpx;
}

.use-current {
  font-size: 24rpx;
  color: var(--primary-color);
}

/* SOC Input */
.soc-input {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--border-color);
  margin-top: 16rpx;
}

/* Plan Button */
.plan-btn {
  margin-top: 30rpx;
}

/* Recent Trips */
.recent-trip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.recent-trip:last-child {
  border-bottom: none;
}

.trip-route {
  display: flex;
  align-items: center;
  flex: 1;
}

.trip-origin, .trip-dest {
  font-size: 28rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-arrow {
  margin: 0 12rpx;
  color: var(--text-muted);
}

.trip-distance {
  font-size: 26rpx;
  color: var(--text-secondary);
}
