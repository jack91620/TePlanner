/* Tesla-style Index Page */
.page-container {
  height: 100vh;
  width: 100%;
  position: relative;
  background: #171717;
}

/* ============ Login Screen ============ */
.login-screen {
  height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
}

.login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx;
  width: 100%;
  max-width: 650rpx;
}

.tesla-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.tesla-logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #e82127 0%, #cc1b20 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
}

.login-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 64rpx;
}

.login-features {
  width: 100%;
  margin-bottom: 64rpx;
}

.feature-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.feature-row:last-child {
  border-bottom: none;
}

.feature-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
  opacity: 0.8;
}

.feature-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-btn {
  width: 100% !important;
  margin-bottom: 24rpx;
}

.login-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ============ Loading Screen ============ */
.loading-screen {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #171717;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #3e6ae1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.large {
  width: 64rpx;
  height: 64rpx;
  border-width: 6rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ============ Main Content ============ */
.main-content {
  height: 100vh;
  width: 100%;
  position: relative;
}

/* ============ Full Screen Map ============ */
.full-map {
  width: 100%;
  height: 100%;
}

/* Map Top Overlay */
.map-top-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 100rpx 32rpx 20rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.location-name-badge {
  background: rgba(0, 0, 0, 0.75);
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
}

.location-name-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.connection-status {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #8b8b8b;
  margin-right: 12rpx;
}

.status-dot.connected {
  background: #34c759;
}

.status-text {
  font-size: 24rpx;
  color: #ffffff;
}

/* Map Right Controls */
.map-right-controls {
  position: absolute;
  top: 180rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.control-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ============ Tabs ============ */
.tabs {
  display: flex;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.5);
  position: relative;
}

.tab.active {
  color: #ffffff;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 2rpx;
}

/* ============ Tab Content ============ */
.tab-content {
  flex: 1;
  overflow: hidden;
}

.station-list,
.recent-list {
  height: 100%;
}

/* Date Group */
.date-group {
  padding: 16rpx 0;
}

.date-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* Recent Items */
.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.recent-info {
  flex: 1;
}

.recent-name {
  font-size: 32rpx;
  color: #ffffff;
  display: block;
  margin-bottom: 4rpx;
}

.recent-address {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.recent-distance {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 24rpx;
}

.location-icon {
  width: 40rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.recent-distance text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* Empty & Loading */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  color: rgba(255, 255, 255, 0.4);
  font-size: 28rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx;
}

/* ============ Route Preview Panel ============ */
.route-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.route-action {
  display: flex;
  align-items: center;
  background: #2a2a2a;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
}

.action-text {
  font-size: 28rpx;
  color: #ffffff;
}

.action-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 8rpx;
}

.edit-link {
  font-size: 28rpx;
  color: #3e6ae1;
}

/* Route Stops */
.route-stops {
  flex: 1;
  margin-bottom: 24rpx;
}

.route-stop {
  display: flex;
  padding: 20rpx 0;
  position: relative;
}

.route-stop::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 56rpx;
  bottom: -20rpx;
  width: 4rpx;
  background: rgba(255, 255, 255, 0.2);
}

.route-stop:last-child::before {
  display: none;
}

.stop-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.origin-icon {
  background: #2a2a2a;
  border: 3rpx solid #ffffff;
}

.origin-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 50%;
}

.charging-icon {
  background: #e82127;
}

.charging-icon .lightning {
  width: 24rpx;
  height: 30rpx;
}

.dest-icon {
  background: transparent;
}

.dest-pin {
  width: 36rpx;
  height: 44rpx;
}

.stop-info {
  flex: 1;
}

.stop-name {
  font-size: 30rpx;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.stop-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.battery-indicator {
  width: 48rpx;
  height: 20rpx;
  background: #3a3a3a;
  border-radius: 4rpx;
  overflow: hidden;
  margin-right: 8rpx;
}

.battery-fill {
  height: 100%;
  background: #34c759;
  border-radius: 4rpx;
}

.soc-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.soc-edit {
  font-size: 26rpx;
  color: #3e6ae1;
  margin-left: 4rpx;
}

.charge-time,
.arrival-time {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 4rpx;
}

/* Route Actions */
.route-actions {
  padding-top: 16rpx;
}

.send-btn {
  width: 100%;
  margin-bottom: 16rpx;
}

.cancel-btn {
  text-align: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.6);
  padding: 16rpx;
}

/* ============ Global Button Styles ============ */
.btn {
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 0;
  text-align: center;
  border: none;
}

.btn-tesla {
  background: #3e6ae1;
  color: #ffffff;
}

.btn-tesla:active {
  background: #2d4fa8;
}
