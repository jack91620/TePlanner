{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$comment": "Source of truth for cross-platform UI constants. Edit this file, then run scripts/generate-tokens.py to regenerate platform outputs (Tokens.swift, Tokens.kt). Hand-curated rather than Style-Dictionary for now — single owner, ~20 tokens; adopt SD when count crosses ~50 or ArkTS adds.",
  "color": {
    "alert": {
      "firing": {
        "bg":          { "value": "#D32F2F", "type": "color", "$comment": "正在触发的徽章/图标背景 (red 700)" },
        "fg":          { "value": "#FFFFFF", "type": "color", "$comment": "白字配 firing.bg" },
        "row_wash":    { "value": "#FFE5E5", "type": "color", "$comment": "整行 12% 红色 wash" }
      },
      "snooze": {
        "fg":          { "value": "#FF9800", "type": "color", "$comment": "snooze 状态徽章 (orange 500)" }
      }
    },
    "trigger_accent": {
      "$comment": "iOS 快捷指令风格——按 trigger.type 给图标着色",
      "cron":              { "value": "#1976D2", "type": "color", "$comment": "时间触发 (blue 700)" },
      "geofence":          { "value": "#388E3C", "type": "color", "$comment": "地理围栏 (green 700)" },
      "state_transition":  { "value": "#3F51B5", "type": "color", "$comment": "状态变化 (indigo 500)" },
      "state_duration":    { "value": "#F57C00", "type": "color", "$comment": "状态持续 (orange 700)" },
      "default":           { "value": "#0066CC", "type": "color", "$comment": "fallback" }
    }
  },
  "spacing": {
    "$comment": "4 / 8 / 12 / 16 / 24 / 32 标准间距阶",
    "xs":  { "value": 4,  "type": "dimension" },
    "sm":  { "value": 8,  "type": "dimension" },
    "md":  { "value": 12, "type": "dimension" },
    "lg":  { "value": 16, "type": "dimension" },
    "xl":  { "value": 24, "type": "dimension" },
    "xxl": { "value": 32, "type": "dimension" }
  },
  "radius": {
    "card":    { "value": 12, "type": "dimension" },
    "tile":    { "value": 8,  "type": "dimension" },
    "capsule": { "value": 50, "type": "dimension" }
  }
}
