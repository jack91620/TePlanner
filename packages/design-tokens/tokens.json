{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$comment": "Source of truth for cross-platform UI constants. Edit this file, then run scripts/generate-tokens.py to regenerate platform outputs (Tokens.swift, Tokens.kt). Hand-curated rather than Style-Dictionary for now — single owner, ~20 tokens; adopt SD when count crosses ~50 or ArkTS adds.",
  "color": {
    "alert": {
      "firing": {
        "bg":          { "value": "#D32F2F", "type": "color", "$comment": "正在触发的徽章/图标背景 (red 700)" },
        "fg":          { "value": "#FFFFFF", "type": "color", "$comment": "白字配 firing.bg" },
        "row_wash":    { "value": "#FFE5E5", "type": "color", "$comment": "整行 12% 红色 wash" }
      },
      "snooze": {
        "fg":          { "value": "#FF9800", "type": "color", "$comment": "snooze 状态徽章 (orange 500)" }
      }
    },
    "trigger_accent": {
      "$comment": "iOS 快捷指令风格——按 trigger.type 给图标着色",
      "cron":              { "value": "#1976D2", "type": "color", "$comment": "时间触发 (blue 700)" },
      "geofence":          { "value": "#388E3C", "type": "color", "$comment": "地理围栏 (green 700)" },
      "state_transition":  { "value": "#3F51B5", "type": "color", "$comment": "状态变化 (indigo 500)" },
      "state_duration":    { "value": "#F57C00", "type": "color", "$comment": "状态持续 (orange 700)" },
      "default":           { "value": "#0066CC", "type": "color", "$comment": "fallback" }
    },
    "badge": {
      "$comment": "胶囊形小徽章——区分预设 vs 自定义规则、其他元数据标签",
      "preset_bg":   { "value": "#1976D2",   "type": "color", "$comment": "蓝底@15% 透明度配 preset_fg" },
      "preset_bg_alpha":   { "value": 0.15, "type": "dimension", "$comment": "preset_bg 应用时的不透明度" },
      "preset_fg":   { "value": "#1976D2",   "type": "color", "$comment": "蓝字" },
      "custom_bg":   { "value": "#388E3C",   "type": "color", "$comment": "绿底@15% 透明度配 custom_fg" },
      "custom_bg_alpha":   { "value": 0.15, "type": "dimension", "$comment": "custom_bg 应用时的不透明度" },
      "custom_fg":   { "value": "#388E3C",   "type": "color", "$comment": "绿字" }
    },
    "wash": {
      "$comment": "整行/卡片轻染色——警告 + snooze 场景",
      "warning":     { "value": "#FFA726",   "type": "color", "$comment": "橙 (orange 400)" },
      "warning_alpha": { "value": 0.12,      "type": "dimension", "$comment": "中度 wash 不透明度" },
      "snooze":      { "value": "#FF9800",   "type": "color", "$comment": "橙 (orange 500)" },
      "snooze_alpha":  { "value": 0.10,      "type": "dimension", "$comment": "snooze 行 wash 不透明度" },
      "permission":  { "value": "#FFA726",   "type": "color", "$comment": "通知权限 banner 底" },
      "permission_alpha": { "value": 0.10,   "type": "dimension", "$comment": "permission banner 不透明度" }
    }
  },
  "spacing": {
    "$comment": "4 / 8 / 12 / 16 / 24 / 32 标准间距阶",
    "xs":  { "value": 4,  "type": "dimension" },
    "sm":  { "value": 8,  "type": "dimension" },
    "md":  { "value": 12, "type": "dimension" },
    "lg":  { "value": 16, "type": "dimension" },
    "xl":  { "value": 24, "type": "dimension" },
    "xxl": { "value": 32, "type": "dimension" }
  },
  "radius": {
    "card":    { "value": 12, "type": "dimension" },
    "tile":    { "value": 8,  "type": "dimension" },
    "capsule": { "value": 50, "type": "dimension" }
  },
  "typography": {
    "$comment": "字号 token——Hero 数字、占位图标、品牌闪屏。value 是结构化对象 {size,weight?,design?}；design 取值 monospaced (SF Mono) 或 monodigit (.monospacedDigit())。Swift 输出 Font、Kotlin 输出 TextStyle。",
    "metric": {
      "$comment": "Hub 上的关键数字 hero：续航 km、SOC 百分比。等宽数字便于跳变时视觉稳定。",
      "hero":    { "type": "typography", "value": { "size": 44, "weight": "semibold", "design": "monodigit" }, "$comment": "Hub 主指标 (续航 km)" },
      "compact": { "type": "typography", "value": { "size": 22, "weight": "bold",     "design": "monodigit" }, "$comment": "Battery ring 中央 SOC%" }
    },
    "code": {
      "$comment": "分享码——6 位字母数字组合，monospaced 让每位等宽。",
      "display": { "type": "typography", "value": { "size": 48, "weight": "bold",     "design": "monospaced" }, "$comment": "ShareCodeSheet 大字显示" },
      "input":   { "type": "typography", "value": { "size": 28, "weight": "semibold", "design": "monospaced" }, "$comment": "ImportShareSheet 输入框" }
    },
    "placeholder_icon": {
      "$comment": "空态/错误/成功状态的 SF Symbol 图标尺寸。sm 和 md 当前并存，下一轮设计可考虑合并。",
      "sm": { "type": "typography", "value": { "size": 36 }, "$comment": "小号空态 (error / battery 统计空态)" },
      "md": { "type": "typography", "value": { "size": 40 }, "$comment": "中号空态 (search / recent / nearby)" },
      "lg": { "type": "typography", "value": { "size": 64 }, "$comment": "大型成功图标 (import 完成)" }
    },
    "splash": {
      "logo": { "type": "typography", "value": { "size": 96, "weight": "bold" }, "$comment": "Login 闪屏品牌 T 字" }
    }
  }
}
