# ===========================================
# TePlanner 生产环境配置
# ===========================================
# 复制此文件到 backend/.env 并修改

# ---------- 应用配置 ----------
APP_NAME=TePlanner
APP_ENV=production
DEBUG=false
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ---------- 数据库配置 ----------
DATABASE_URL=sqlite+aiosqlite:///./teplanner.db

# ---------- Tesla API 配置 ----------
TESLA_API_BASE_URL=https://owner-api.teslamotors.com
TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.cn.vn.cloud.tesla.cn
TESLA_CLIENT_ID=35abc05d-fe48-4278-a834-f85bb584e136
TESLA_CLIENT_SECRET=ta-secret.TROXm7LUc9FuR$C!
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TESLA_TOKEN_ENCRYPTION_KEY=CHANGE_ME

# !! 重要: 修改为你的服务器公网IP !!
TESLA_REDIRECT_URI=http://YOUR_SERVER_IP:8000/api/v1/auth/tesla/callback

# OAuth Token (授权后自动填入)
TESLA_ACCESS_TOKEN=
TESLA_REFRESH_TOKEN=

# ---------- 腾讯地图 API 配置 ----------
TENCENT_MAP_KEY=your-tencent-map-api-key
TENCENT_MAP_SECRET=your-tencent-map-secret

# ---------- 微信小程序配置 ----------
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ---------- JWT 配置 ----------
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- CORS 配置 ----------
CORS_ORIGINS=["http://YOUR_SERVER_IP:8000"]
