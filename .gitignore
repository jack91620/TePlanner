# Claude Code: track shared settings, ignore user-local overrides + transient state
.claude/*
!.claude/settings.json
.claude/settings.local.json

# Xcode / SPM (paths after Phase B repo restructure → apps/ios/)
.build/
apps/ios/.build/
.derivedData/
apps/ios/.derivedData/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/xcode/xcuserdata/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
apps/ios/.swiftpm/xcode/xcuserdata/
apps/ios/.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Build outputs / scratch
tmp/screenshots/

# iOS local config (real API keys + bundle ID), per-user
apps/ios/Config.xcconfig
apps/ios/Sources/TePlanner/Resources/Secrets.plist

# Generated by xcodegen — regenerate with `make project`
apps/ios/TePlannerApp.xcodeproj/

# Generated by CocoaPods — regenerate with `make project`
apps/ios/Pods/
apps/ios/TePlannerApp.xcworkspace/

# Podfile.lock IS checked in (pins pod versions for reproducibility)

# E2E
e2e/maestro/.env
.maestro/

# TestFlight / distribution
build/
deploy/ExportOptions.plist

# Ops snapshots / reports — generated, host-specific
ops/state/
ops/reports/

# Phase F — Android per-machine secrets + build artifacts. The SDK
# location (sdk.dir) Android Studio writes into local.properties is
# host-specific too, so the whole file is gitignored — track the
# example template only.
apps/android/local.properties
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/core/*/build/
apps/android/.idea/
apps/android/*.iml
apps/android/app/*.iml
apps/android/core/*/*.iml

# Generated SDK build artifacts (Phase C codegen) — the SDK source IS
# committed under packages/clients/{swift,kotlin,arkts}/ but build
# outputs (Package.resolved, .build, gradle .lock, node_modules) are
# per-machine and would fail the codegen-verify gate.
packages/clients/swift/Package.resolved
packages/clients/swift/.build/
packages/clients/swift/.swiftpm/
packages/clients/kotlin/.gradle/
packages/clients/kotlin/build/
packages/clients/arkts/node_modules/
packages/clients/arkts/dist/
apps/android/.kotlin/
