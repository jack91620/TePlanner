# ===========================================
# TePlanner 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ===========================================

# ---------- 应用配置 ----------
APP_NAME=TePlanner
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ---------- 数据库配置 ----------
# SQLite (开发环境)
DATABASE_URL=sqlite:///./teplanner.db

# PostgreSQL (生产环境)
# DATABASE_URL=postgresql://user:password@localhost:5432/teplanner

# Redis (缓存)
REDIS_URL=redis://localhost:6379/0

# ---------- Tesla API 配置 ----------
# MVP阶段使用 Owner API
TESLA_API_BASE_URL=https://owner-api.teslamotors.com
TESLA_CLIENT_ID=your-tesla-client-id
TESLA_CLIENT_SECRET=your-tesla-client-secret

# Fleet API (审批通过后启用)
# TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
# TESLA_FLEET_CLIENT_ID=your-fleet-client-id

# Token加密密钥 (用于加密存储用户的Tesla Token)
TESLA_TOKEN_ENCRYPTION_KEY=your-encryption-key-32-bytes-long

# ---------- 腾讯地图 API 配置 ----------
TENCENT_MAP_KEY=your-tencent-map-api-key
TENCENT_MAP_SECRET=your-tencent-map-secret

# ---------- 微信小程序配置 ----------
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ---------- JWT 配置 ----------
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- CORS 配置 ----------
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Sentry (可选，错误监控) ----------
# SENTRY_DSN=your-sentry-dsn
