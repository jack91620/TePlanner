# Webhook credentials for server-monitor.sh + daily-inspection.sh →
# OpenClaw → WeChat alert path. Real values live at
# /home/ubuntu/ops/alert.env on the production VM (gitignored).
#
# Token shared with ~/.openclaw/openclaw.json (hooks.token) and
# TePlanner backend/.env (OPENCLAW_HOOK_TOKEN). Rotate all three
# together when changing.
OPENCLAW_HOOK_URL="http://127.0.0.1:18789/hooks"
OPENCLAW_HOOK_TOKEN="REPLACE_WITH_REAL_TOKEN_FROM_PROD"
